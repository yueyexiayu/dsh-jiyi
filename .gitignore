# Publish an explicit source-only tree. Local evidence and runtime data stay private.
/*
!/.gitignore
!/LICENSE
!/README.md
!/README.en.md
!/docs/
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/*.svg
!/package.json
!/cordis.patch.yml
!/lib/
!/lib/**
!/locale/
!/locale/*.json
!/scripts/
!/scripts/**
!/test/
!/test/**
!/deps/
/deps/*
!/deps/package.json
!/deps/package-lock.json
!/models/
/models/**
!/models/manifest.json
!/evidence/
/evidence/**
!/evidence/.gitkeep

# Original private regression source: public tests use a synthetic replacement.
/test/fixtures/task-v0111-user-message.txt
**/node_modules/
**/.DS_Store
**/*.sqlite*
**/*.sock
**/*.log
**/.env*
**/*credentials*
